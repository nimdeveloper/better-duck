# Rust build output (this worktree is shared with the code branches)
/target/

# Machine-specific tool wiring. The portable Mintlify skills are committed under
# .agents/skills/ with skills-lock.json; per-tool links (e.g. .claude/skills/*)
# are re-materialized locally by `npx skills` from those.
/.claude/

# Raw benchmark inputs; the published charts are docs/benchmarks/*.svg
docs/benchmarks/_raw_*.json

# Mintlify / Node local caches
/.mint/
docs/.mint/
node_modules/
docs/node_modules/

# Source materialized from `main` only to author the docs against (never committed
# on this docs-only branch). Safe to delete; re-create with:
#   git archive main -- crates examples .claude/skills README.md Cargo.toml Cargo.lock | tar -x
/crates/
/examples/
/xtask/
/target/
/bench-comparison/
/README.md
/Cargo.toml
/Cargo.lock
/CHANGELOG.md
