                  "guide/duckdb-essentials",
                  "guide/benchmarks"
                ]
              }
            ]
          },
          {
            "tab": "Core + Macros",
            "groups": [
              {
                "group": "Core",
                "pages": [
                  "core/connections",
                  "core/queries-and-values",
                  "core/parameters-and-prepared",
