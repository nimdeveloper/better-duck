{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "better-duck",
  "description": "A safe, embedded-first Rust client for DuckDB, with an optional Diesel 2.3 ORM backend, UDF/derive macros, and a Tauri v2 plugin.",
  "colors": {
    "primary": "#CA8A04",
    "light": "#FACC15",
    "dark": "#A16207"
  },
  "favicon": "/favicon.svg",
