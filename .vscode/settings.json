{
  "conventionalCommits.emojiFormat": "emoji",
  "conventionalCommits.scopes": ["core", "helpers", "internal"],
  "[rust]": {
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true
  },
  "lldb.script": { "lang.rust.toolchain": "stable-x86_64-pc-windows-gnu" },
  "cSpell.words": [
    "appendable",
    "appender",
    "autoinstall",
    "chrono",
    "cstring",
    "Datelike",
    "DUCKDB",
    "HUGEINT",
    "libduckdb",
    "milli",
    "nparams",
    "SQLNULL",
    "subsec",
    "Timelike",
    "TINYINT",
    "UHUGEINT",
    "UINTEGER",
    "Uninit",
    "USMALLINT",
    "UTINYINT",
    "VARINT"
  ],
  "material-icon-theme.files.customClones": [
    {
      "name": "rust-mod",
      "base": "rust",
      "color": "blue-400",
      "fileNames": ["mod.rs"]
    },
    {
      "name": "rust-lib",
      "base": "rust",
      "color": "light-green-300",
      "lightColor": "light-green-600",
      "fileNames": ["lib.rs"]
    },
    {
      "name": "rust-main",
      "base": "rust",
      "color": "indigo-300",
      "lightColor": "indigo-600",
      "fileNames": ["main.rs"]
    }
  ],
  // "rust-analyzer.check.command": "clippy",
  // "rust-analyzer.check.extraArgs": ["-- -D warnings"],
  "rust-analyzer.checkOnSave": true,
  // rust-analyzer resolves the whole workspace with ONE unified feature set
  // per crate (it has no `-p`-style per-package scoping the way a manual
  // `cargo test -p X` invocation does). `better-duck-core`'s `chrono` is a
  // default feature, but `better-duck-diesel` depends on it with
  // `default-features = false` and only forwards `chrono` when diesel's own
  // (separately-named, same-spelled) `chrono` feature is requested. Left
  // unspecified, rust-analyzer's unified pass turns core's chrono "on"
  // (default) while leaving diesel's own chrono flag off, so diesel's
  // `#[cfg(not(feature = "chrono"))] mod date_native;` still compiles but the
  // `better_duck_core::types::date_native` module it imports has been
  // compiled out — a false-positive "unresolved import"/type-mismatch error
  // that has nothing to do with real code correctness (see CI's `ci.yml`
  // Linux job comment for the same mechanism). Explicitly listing "chrono"
  // here turns it on for every workspace member that declares a
  // same-named feature — core *and* diesel together — keeping them
  // consistent. Matches the exact feature set CI's "Doctests" job already
  // proves safe (`cargo test --workspace --doc --features "chrono,decimal,async,pool,udf"`).
  "rust-analyzer.cargo.features": ["chrono", "decimal", "async", "pool", "udf"],

  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "XXX",
    "[ ]",
    "[x]",
    "TODO",
    "FIXME",
    "FIX",
    "CHECKME",
    "CHECK",
    "WARNING",
    "WARN",
    "ATTENTION",
    "IMPORTANT",
    "QUESTION",
    "EXPAIN",
    "INFORMATION",
    "INFO",
    "EXPERIMENTAL",
    "EXPERIMENT"
  ],
  "todo-tree.general.tagGroups": {
    "BUG": ["BUG", "HACK"],
    "FIXME": ["FIXME", "FIX"],
    "CHECK": ["CHECKME", "CHECK"],
    "WARN": ["WARNING", "WARN", "ATTENTION"],
    "IMPORTANT": ["IMPORTANT"],
    "QUESTION": ["QUESTION", "EXPAIN"],
    "INFO": ["INFORMATION", "INFO"],
    "EXPERIMENT": ["EXPERIMENTAL", "EXPERIMENT"]
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "foreground": "#7fffd4",
      "type": "text-and-comment"
    },
    "BUG": {
      "icon": "bug",
      "foreground": "#ff0037",
      "type": "text-and-comment"
    },
    "FIXME": {
      "icon": "tools",
      "foreground": "#FF8C00",
      "type": "text-and-comment"
    },
    "WARN": {
      "foreground": "#FF2D00",
      "icon": "alert",
      "type": "text-and-comment"
    },
    "QUESTION": {
      "icon": "question",
      "foreground": "#3498DB",
      "type": "text-and-comment"
    },
    "INFO": {
      "icon": "info",
      "foreground": "#f0ffff",
      "type": "text-and-comment"
    },
    "IMPORTANT": {
      "icon": "north-star",
      "foreground": "#98C379",
      "type": "text-and-comment"
    },
    "EXPERIMENT": {
      "icon": "beaker",
      "foreground": "#ff0037",
      "type": "text-and-comment"
    }
  }
}
