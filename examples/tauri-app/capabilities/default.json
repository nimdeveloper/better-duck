{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Grants the example window the better-duck commands, with a connection and path scope.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "better-duck-tauri:allow-load",
      "allow": [{ "connection": "duckdb::memory:" }]
    },
    "better-duck-tauri:allow-close",
    "better-duck-tauri:allow-select",
    "better-duck-tauri:allow-execute",
    "better-duck-tauri:allow-append-rows",
    "better-duck-tauri:allow-tables",
    "better-duck-tauri:allow-columns",
    "better-duck-tauri:allow-explain",
    "better-duck-tauri:allow-checkpoint",
    {
      "identifier": "better-duck-tauri:allow-import",
      "allow": [{ "path": "data/" }]
    },
    {
      "identifier": "better-duck-tauri:allow-export",
      "allow": [{ "path": "data/" }]
    }
  ]
}
